# Copy to .env on the server. Never commit the real file.
APP_NAME="Card Casino"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_HTTP_PORT=8000

# Images published by GitLab CI (docker-compose pulls these on the VPS).
APP_IMAGE=registry.gitlab.com/czar.gaba/baseplate-react
WEB_IMAGE=registry.gitlab.com/czar.gaba/baseplate-react-web

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (MySQL 8, private network only) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pusoy
DB_USERNAME=pusoy
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis (cache, queues, broadcasting) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# --- Broadcasting (Laravel Reverb) ---
BROADCAST_CONNECTION=reverb

# Public endpoint used by browsers (through Cloudflare / aaPanel Nginx).
REVERB_HOST=your-domain.example
REVERB_PORT=443
REVERB_SCHEME=https

# Internal endpoint the app containers use to publish events.
REVERB_APP_HOST=reverb
REVERB_APP_PORT=8080
REVERB_APP_SCHEME=http
REVERB_PATH=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PUBLISH_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Files (private storage for KYC + proof of payment) ---
FILESYSTEM_DISK=local

# --- Platform ---
GAME_POINT_VALUE_MINOR=0
PLATFORM_FEE_ENABLED=false

# Real-money features are DISABLED until legal, PAGCOR and payment-provider
# approvals are recorded. Do not flip these in production without sign-off.
REAL_MONEY_DEPOSITS=false
REAL_MONEY_WITHDRAWALS=false
CASH_EQUIVALENT_SETTLEMENT=false
REAL_MONEY_ROOMS=false

VITE_APP_NAME="${APP_NAME}"
